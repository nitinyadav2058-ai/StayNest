<%- layout('/layouts/boilerplate.ejs') %>

<body>

    <style>
        .edit-container {
            max-width: 850px;
            margin: 40px auto;
        }

        .edit-card {
            border: none;
            border-radius: 20px;
            padding: 35px;
            background: #fff;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
        }

        .edit-title {
            font-weight: 600;
            margin-bottom: 30px;
        }

        .form-label {
            font-weight: 500;
            margin-bottom: 8px;
        }

        .form-control,
        .form-select {
            border-radius: 10px;
            padding: 11px 14px;
            border: 1px solid #ddd;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #ff385c;
            box-shadow: 0 0 0 0.15rem rgba(255, 56, 92, 0.12);
        }

        textarea.form-control {
            min-height: 130px;
            resize: vertical;
        }

        .image-section {
            background: #f8f8f8;
            padding: 20px;
            border-radius: 15px;
        }

        .original-image {
            width: 180px;
            height: 120px;
            object-fit: cover;
            border-radius: 12px;
            margin-top: 8px;
            box-shadow: 0 3px 10px rgba(0, 0, 0, 0.12);
        }

        .edit-btn {
            background-color: #ff385c;
            border: none;
            border-radius: 10px;
            padding: 12px 30px;
            font-size: 1rem;
            font-weight: 500;
            color: white;
            transition: 0.2s ease;
        }

        .edit-btn:hover {
            background-color: #e31c5f;
            color: white;
            transform: translateY(-1px);
        }

        .cancel-btn {
            border-radius: 10px;
            padding: 12px 25px;
        }

        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            margin-top: 25px;
            margin-bottom: 15px;
        }
    </style>


    <div class="edit-container">

        <div class="edit-card">

            <h3 class="edit-title">
                Edit your Listing
            </h3>


            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=PUT"
                novalidate
                class="needs-validation"
                enctype="multipart/form-data"
            >

                <!-- ================= BASIC INFORMATION ================= -->

                <div class="section-title">
                    Basic Information
                </div>

                <!-- Title -->
                <div class="mb-3">

                    <label for="title" class="form-label">
                        Title
                    </label>

                    <input
                        id="title"
                        name="listing[title]"
                        value="<%= listing.title %>"
                        type="text"
                        class="form-control"
                        placeholder="Enter listing title"
                        required
                    >

                    <div class="valid-feedback">
                        Title looks good!
                    </div>

                    <div class="invalid-feedback">
                        Please enter a title.
                    </div>

                </div>


                <!-- Description -->
                <div class="mb-3">

                    <label for="description" class="form-label">
                        Description
                    </label>

                    <textarea
                        id="description"
                        name="listing[description]"
                        class="form-control"
                        placeholder="Describe your property..."
                        required
                    ><%= listing.description %></textarea>

                    <div class="invalid-feedback">
                        Please enter a description.
                    </div>

                </div>


                <!-- Category -->
                <div class="mb-3">

                    <label for="category" class="form-label">
                        Category
                    </label>

                    <select
                        id="category"
                        name="listing[category]"
                        class="form-select"
                        required
                    >

                        <option value="" disabled>
                            Select a category
                        </option>

                        <option value="Trending"
                            <%= listing.category === "Trending" ? "selected" : "" %>>
                            🔥 Trending
                        </option>

                        <option value="Rooms"
                            <%= listing.category === "Rooms" ? "selected" : "" %>>
                            🛏️ Rooms
                        </option>

                        <option value="Iconic Cities"
                            <%= listing.category === "Iconic Cities" ? "selected" : "" %>>
                            🏙️ Iconic Cities
                        </option>

                        <option value="Mountain"
                            <%= listing.category === "Mountain" ? "selected" : "" %>>
                            ⛰️ Mountain
                        </option>

                        <option value="Castles"
                            <%= listing.category === "Castles" ? "selected" : "" %>>
                            🏰 Castles
                        </option>

                        <option value="Amazing pool"
                            <%= listing.category === "Amazing pool" ? "selected" : "" %>>
                            🏊 Amazing pool
                        </option>

                        <option value="Camping"
                            <%= listing.category === "Camping" ? "selected" : "" %>>
                            ⛺ Camping
                        </option>

                        <option value="Farms"
                            <%= listing.category === "Farms" ? "selected" : "" %>>
                            🐄 Farms
                        </option>

                        <option value="Arctic"
                            <%= listing.category === "Arctic" ? "selected" : "" %>>
                            ☃️ Arctic
                        </option>

                    </select>

                    <div class="invalid-feedback">
                        Please select a category.
                    </div>

                </div>


                <!-- ================= IMAGE ================= -->

                <div class="section-title">
                    Listing Image
                </div>

                <div class="image-section mb-3">

                    <!-- Original Image -->
                    <label class="form-label">
                        Current Image
                    </label>

                    <br>

                    <img
                        src="<%= originalImageUrl %>"
                        alt="Original Image"
                        class="original-image"
                    >

                    <!-- Upload New Image -->
                    <div class="mt-3">

                        <label for="image" class="form-label">
                            Upload New Image
                        </label>

                        <input
                            id="image"
                            name="image"
                            type="file"
                            class="form-control"
                            accept="image/*"
                        >

                        <small class="text-muted">
                            Leave empty if you want to keep the current image.
                        </small>

                    </div>

                </div>


                <!-- ================= PRICE & LOCATION ================= -->

                <div class="section-title">
                    Price & Location
                </div>

                <div class="row">

                    <!-- Price -->
                    <div class="mb-3 col-md-4">

                        <label for="price" class="form-label">
                            Price
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ₹
                            </span>

                            <input
                                id="price"
                                name="listing[price]"
                                value="<%= listing.price %>"
                                type="number"
                                class="form-control"
                                placeholder="1000"
                                min="0"
                                required
                            >

                        </div>

                        <div class="invalid-feedback">
                            Please enter a valid price.
                        </div>

                    </div>


                    <!-- Location -->
                    <div class="mb-3 col-md-8">

                        <label for="location" class="form-label">
                            Location
                        </label>

                        <input
                            id="location"
                            name="listing[location]"
                            value="<%= listing.location %>"
                            type="text"
                            class="form-control"
                            placeholder="Enter city or location"
                            required
                        >

                        <div class="invalid-feedback">
                            Please enter a valid location.
                        </div>

                    </div>

                </div>


                <!-- Country -->
                <div class="mb-3">

                    <label for="country" class="form-label">
                        Country
                    </label>

                    <input
                        id="country"
                        name="listing[country]"
                        value="<%= listing.country %>"
                        type="text"
                        class="form-control"
                        placeholder="Enter country"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid country.
                    </div>

                </div>


                <!-- ================= BUTTONS ================= -->

                <div class="d-flex gap-2 mt-4">

                    <button
                        type="submit"
                        class="btn edit-btn"
                    >
                        <i class="fa-solid fa-pen-to-square me-2"></i>
                        Update Listing
                    </button>

                    <a
                        href="/listings/<%= listing._id %>"
                        class="btn btn-outline-secondary cancel-btn"
                    >
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</body>